---
import SiteLayout from "../layouts/SiteLayout.astro";
import { resume } from "../data/resume";
---
<SiteLayout title="Work — Ishant Juyal" description="Product experience across PICKUP Coffee, Crework, Houseworks, and Jar.">
  <main id="main">
    <header class="page-intro"><h1>Work</h1><p>Product manager and ex-founder. Consumer apps, growth, and the systems behind them.</p></header>
    <section class="page-section" aria-labelledby="career-heading">
      <h2 class="section-label" id="career-heading">Where I’ve been</h2>
      <div class="career-list">
        {resume.experience.map((job) => (
          <details class="job" data-career-company={job.company}>
            <summary><span><strong>{job.company}</strong><span class="job-role">{job.role}</span></span><span class="job-period">{job.period}<span class="expand-mark" aria-hidden="true">+</span></span></summary>
            <div class="prose small"><ul>{job.bullets.map((bullet) => <li>{bullet}</li>)}</ul></div>
          </details>
        ))}
      </div>
    </section>
    <section class="page-section" aria-labelledby="education-heading">
      <h2 class="section-label" id="education-heading">Education</h2>
      <p class="education">{resume.education.school}<br /><span class="muted small">{resume.education.degree} · {resume.education.period}</span></p>
    </section>
    <p class="small muted">I also make <a href="/projects">small things on the side</a>. <a href="mailto:ishantnit@gmail.com">Get in touch ↗</a></p>
  </main>
</SiteLayout>
<style>
  .career-list { margin-top: 10px; }
  .job + .job { border-top: 1px solid var(--site-border); }
  summary { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; padding: 17px 0; cursor: pointer; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  summary strong { font-weight: 500; font-size: 14px; }
  summary:hover strong { text-decoration: underline; text-underline-offset: 4px; }
  .job-role { display: block; font-size: 12px; color: var(--site-muted); }
  .job-period { display: flex; gap: 16px; color: var(--site-muted); font-size: 11px; white-space: nowrap; }
  .expand-mark { font-family: var(--site-mono); }
  details[open] .expand-mark { transform: rotate(45deg); }
  .job .prose { padding: 3px 0 13px; }
  .education { margin-top: 13px; font-size: 14px; }
  @media (max-width: 500px) { summary { flex-wrap: wrap; gap: 5px; } .job-period { width: 100%; justify-content: space-between; } }
</style>
