---
// src/pages/career.astro
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';

const workExperience = [
    {
        company: 'Shuru Tech',
        companyUrl: 'https://www.shurutech.com/',
        role: 'Product Manager',
        period: 'Oct 2024 - Present',
        description: 'Worked with PICKUP COFFEE - A Philippines based mobile first coffee brand',
        highlights: [
            'Led Mexico app localization and launch, aligning product, engineering, and ops across regions to ensure commercial readiness.',
            'Launched in-app Delivery feature integrating with Pandago E2E, now contributing 15% of app orders and around $125k per month revenue.',
            'Led end-to-end CleverTap integration and analytics events, establishing data-driven A/B guidelines to improve product decisions and customer engagement.',
        ]
    },
    {
        company: 'Crework',
        companyUrl: 'https://www.crework.club/',
        role: 'Co-founder',
        period: 'Dec 2023 - Sep 2024',
        description: 'Built a community led CBC focusing on product management education',
        highlights: [
            'Co-founded and led in-house LMS development for cohorts reducing operating effort and improving course completion rate.',
            'Scaled revenue for bootstrapped product to ₹3L per batch. Built funnels increasing enrollments by 50% via self-serve.',
            'Hired and managed cross-functional teams across engineering, growth, and design. Led cohorts with 30+ students across 2 batches.'
        ]
    },
    {
        company: 'Houseworks',
        companyUrl: 'http://houseworksinc.co/',
        role: 'Associate Product Manager',
        period: 'Jul 2022 - Dec 2023',
        description: 'Healthcare technology and cancer patient care solutions',
        highlights: [
            'Improved EMR UI and modules, reducing user complaints by 15% through targeted UX enhancements and streamlined workflows.',
            'Developed B2C platform for cancer patients to get second opinions on their treatment plans from a review board.'
        ]
    },
    {
        company: 'Jar',
        companyUrl: 'https://www.myjar.app/',
        role: 'Product Analyst',
        period: 'Oct 2021 - Jul 2022',
        description: 'Digital gold savings and investment platform',
        highlights: [
            'Led design and analysis of experiments on home screen, offers, and nudges, increasing home-screen-to-first-transaction conversion from 10% to 14%.',
            'Collaborated with growth team to boost WoW retention by ~20% using targeted lifecycle push campaigns.',
            'Created Product Analytics events from scratch and established a naming guide used across the company.'
        ]
    }
];

const siteTitle = "Career - Ishant Juyal";
const siteDescription = "My professional work experience and career journey";
const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
---

<Layout title={siteTitle} description={siteDescription} canonicalURL={canonicalURL}>
    <main>
        <section id="intro">
            <h1>Career</h1>
        </section>

        <section id="work-experience">
            {workExperience.length > 0 ? (
                <div class="work-list">
                    {workExperience.map(job => (
                        <div class="work-item">
                            <div class="work-header">
                                <h4 class="work-role">{job.role}</h4>
                                <span class="work-period">{job.period}</span>
                            </div>
                            <p class="work-company">
                                <a href={job.companyUrl} target="_blank" rel="noopener noreferrer">{job.company}</a>
                            </p>
                            <p class="work-description">{job.description}</p>
                            {job.highlights && job.highlights.length > 0 && (
                                <ul class="work-highlights">
                                    {job.highlights.map(highlight => (
                                        <li>{highlight}</li>
                                    ))}
                                </ul>
                            )}
                        </div>
                    ))}
                </div>
            ) : (
                <p>No work experience listed yet.</p>
            )}
        </section>
    </main>
</Layout>

<style>
    .work-list {
        margin-top: 1.5rem;
    }

    .work-item {
        margin-bottom: 2.5rem;
        padding-bottom: 2rem;
        border-bottom: 1px solid #e5e5e5;
    }

    .work-item:last-child {
        border-bottom: none;
    }

    .work-header {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        margin-bottom: 0.5rem;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .work-role {
        font-size: 1.3em;
        font-weight: 600;
        margin: 0;
        color: #333;
    }

    .work-period {
        color: #666;
        font-size: 0.9em;
        white-space: nowrap;
    }

    .work-company {
        color: var(--link-color);
        font-weight: 500;
        margin: 0.25rem 0;
    }

    .work-description {
        color: #555;
        margin: 0.75rem 0;
    }

    .work-highlights {
        margin-top: 0.75rem;
        padding-left: 1.5rem;
        color: #555;
    }

    .work-highlights li {
        margin-bottom: 0.5rem;
        line-height: 1.6;
    }

    @media (max-width: 640px) {
        .work-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .work-period {
            margin-top: 0.25rem;
        }
    }
</style>
