---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import '../styles/global.css';

const allPosts = await getCollection('posts');
const featuredPosts = allPosts.filter(post => post.data.featured);
featuredPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const projects = [
    { name: 'PM Quest', url: 'https://pmquest.ishantjuyal.com/', description: 'Daily challenges to level up your product thinking' },
    { name: 'TailorUp', url: 'https://tailorup.vercel.app/', description: 'Tailor your resume for any job in 2 minutes' },
    { name: 'Appvia', url: 'https://www.appvia.live/', description: 'Play Store reviews of your app, auto-delivered to your Slack' },
    { name: 'Loopwise', url: 'https://www.loopwise.live/', description: 'Collect feedback that actually moves things' },
    { name: 'Secret Santa Organizer', url: 'https://www.secretsanta.world/', description: 'Effortless online Secret Santa Gift Echange Organizer' },
    { name: 'Year Progress Tracker', url: 'https://chromewebstore.google.com/detail/acdnmoeegibdamcidkjohklcnnhghfdf?utm_source=item-share-cb', description: 'A chrome extension to help you track your yearly progress and goals' },
    { name: 'Focus Hours', url: 'https://chromewebstore.google.com/detail/focus-hours/ogldhbljdkjlcmlfhlebfbfnonlahflh?authuser=0&hl=en-GB', description: 'Maintain better focus and minimise distractions by blocking specific websites.' },
];

function formatDate(date) {
    return date.toLocaleDateString('en-US', {
        day: 'numeric',
        month: 'short',
        year: 'numeric'
    });
}

const siteTitle = "Ishant Juyal";
const siteDescription = "Hi! Welcome to Ishant's personal website where he shares his thoughts on everything.";
const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
---

<Layout title={siteTitle} description={siteDescription} canonicalURL={canonicalURL}>
    <main>
        <section id="intro">
            <h1>Hey 👋</h1>
            <p>I'm Ishant, a Product Manager and an ex-founder who loves to build products, solve problems and eat a lot.</p>

            <p>Currently I am working at Pickup Coffee (Philippines and Mexico) where I majorly work on improving user experience, engagement and retention. </p>

            <p>
            My socials:
            <a href="https://peerlist.io/ishantjuyal" target="_blank">Peerlist</a>, 
            <a href="https://www.linkedin.com/in/ishantjuyal/" target="_blank">LinkedIn</a>,
            <a href="https://x.com/juyal_ishant" target="_blank">X</a>
            </p>
            
            <p>Subscribe to my newsletter here: <a href="https://ishant.substack.com/" target="_blank">Ishant's Newsletter</a></p>
        </section>

        <p>I build side projects and products for fun whenever I am free.</p>

        <section id="projects">
            <h3>My Products/ Projects</h3>
            {projects.length > 0 ? (
                <div class="project-list">
                    {projects.map(project => (
                        <p>
                            <a href={project.url} target="_blank" rel="noopener noreferrer">{project.name}</a> - {project.description}
                        </p>
                    ))}
                </div>
            ) : (
                <p>No projects listed yet.</p>
            )}
        </section>

        <p>Sometimes, I write too.</p>

        <section id="blog-posts">
            <h3>My Favourite Posts</h3>
            {featuredPosts.length > 0 ? (
                <ul class="post-list">
                    {featuredPosts.map(post => (
                        <li class="post-item">
                            <span class="post-date">{formatDate(post.data.date)}</span>
                            <span class="post-title">
                                <a href={`/posts/${post.slug}`}>{post.data.title}</a>
                            </span>
                        </li>
                    ))}
                </ul>
            ) : (
                <p class="no-posts-message">No featured posts yet. Check back soon!</p>
            )}
            <p class="view-all-posts"><a href="/posts">View all posts →</a></p>
        </section>
    </main>
</Layout>