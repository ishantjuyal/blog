---
import SiteLayout from "../layouts/SiteLayout.astro";
import FunWorld from "../components/FunWorld.astro";
import { getCollection } from "astro:content";
import { projects } from "../data/projects";
const latestPosts = (await getCollection("posts")).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 2);
const selectedProjects = projects.filter((project) => project.favorite).slice(0, 3);
---
<SiteLayout title="Ishant Juyal — Product Manager & Builder" description="Ishant Juyal is a product manager at PICKUP Coffee, former co-founder of Crework, and builder of PM Quest, TailorUp, and Appvia. Projects, work, and notes.">
  <main id="main">
    <div id="home-content">
      <header class="home-intro">
        <h1>Ishant Juyal</h1>
        <p>I build products and figure things out along the way.</p>
        <p class="intro-detail">Product at <a href="/work">PICKUP Coffee</a>. Previously co-founded Crework.<br class="desktop-break" /> An engineer by education, an occasional <a href="/notes">writer</a> by habit.</p>
      </header>
      <section class="home-section" aria-labelledby="projects-heading">
        <div class="section-heading">
          <h2 id="projects-heading" class="section-label">A few things I’ve made</h2>
          <a href="/projects">All projects <span aria-hidden="true">↗</span></a>
        </div>
        <ul class="index-list home-projects">
          {selectedProjects.map((project) => (
            <li><a class="index-link project-card" href={`/projects/${project.slug}`} data-project-name={project.name} data-project-code={project.code} data-project-type={project.type}>
              <span class="project-name">{project.name}</span>
              <span class="project-description">{project.shortDescription}</span>
              <span class="arrow" aria-hidden="true">↗</span>
            </a></li>
          ))}
        </ul>
      </section>
      <section class="home-section" aria-labelledby="notes-heading">
        <div class="section-heading">
          <h2 id="notes-heading" class="section-label">Occasional notes</h2>
          <a href="/notes">All notes <span aria-hidden="true">↗</span></a>
        </div>
        <ul class="index-list notes-list">
          {latestPosts.map((post) => (
            <li><a class="index-link" href={`/notes/${post.slug}`}>
              <span class="item-title">{post.data.title}</span>
              <time datetime={post.data.date.toISOString()}>{post.data.date.getUTCFullYear()}</time>
            </a></li>
          ))}
        </ul>
      </section>
      <p class="home-postscript">There’s a little more <a href="/life">about me</a>, or you can just <a href="mailto:ishantnit@gmail.com">say hello</a>.</p>
    </div>
    <FunWorld />
  </main>
</SiteLayout>
<style>
  .home-intro { margin-bottom: 43px; }
  .home-intro h1 { margin-bottom: 18px; }
  .home-intro > p { font-size: 15px; }
  .home-intro .intro-detail { margin-top: 12px; color: var(--site-muted); font-size: 14px; line-height: 1.8; }
  .home-section { margin-bottom: 34px; }
  .home-section .section-heading { margin-bottom: 5px; }
  .home-projects .index-link { display: grid; grid-template-columns: 104px minmax(0, 1fr) 12px; gap: 18px; padding: 12px 0; }
  .project-name { font-size: 14px; font-weight: 500; }
  .project-description { color: var(--site-muted); font-size: 13px; }
  .index-link:hover .project-name { text-decoration: underline; text-underline-offset: 4px; }
  .notes-list .index-link { padding: 10px 0; font-size: 14px; }
  .home-postscript { color: var(--site-muted); font-size: 13px; margin-top: 37px; }
  @media (max-width: 600px) {
    .desktop-break { display: none; }
    .home-intro { margin-bottom: 33px; }
    .home-projects .index-link { grid-template-columns: minmax(0, 1fr) 12px; gap: 0 10px; padding: 12px 0; }
    .project-description { grid-row: 2; }
    .home-projects .arrow { grid-column: 2; grid-row: 1; }
  }
</style>
