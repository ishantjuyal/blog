---
interface Props {
  kind?: "both" | "role" | "question" | "feedback";
  topic?: string;
}
const { kind = "both", topic } = Astro.props;
const source = new URL(Astro.url.pathname, Astro.site).href;
const email = "ishantnit@gmail.com";
const invitations = {
  both: { heading: "Get in touch", description: "I read messages on LinkedIn and X. Email works too." },
  role: { heading: "Have a role in mind?", description: "Tell me about your team and what you’re building. Find me on LinkedIn, or send an email." },
  question: { heading: "Have a question?", description: "Getting into product, building something, or curious about my experience? Find me on LinkedIn or X." },
  feedback: { heading: "What did you think?", description: "If something here was useful, or you see it differently, I’d like to hear." },
};
const actions = {
  role: {
    label: "Discuss a role",
    subject: "Product role — via ishantjuyal.com",
    body: "Hi Ishant,\n\nI’d like to discuss a product role.\n\nTeam / company:\nRole / problem:\nWhat caught my eye on your site (optional):",
  },
  question: {
    label: "Ask me a question",
    subject: "A question — via ishantjuyal.com",
    body: "Hi Ishant,\n\nA little context about me:\nMy question:\nWhat brought me to your site (optional):",
  },
  feedback: {
    label: "Share a thought",
    subject: `Thoughts on ${topic || "your website"} — via ishantjuyal.com`,
    body: "Hi Ishant,\n\nWhat stood out to me:\nWhat I found useful or would see differently:",
  },
};
const intents = kind === "both" ? ["role", "question"] as const : [kind];
const { heading, description } = invitations[kind];
const linkedin = { label: "LinkedIn", href: "https://www.linkedin.com/in/ishantjuyal/" };
const twitter = { label: "X", href: "https://x.com/juyal_ishant" };
---
<section class="contact-invitation" aria-label={heading}>
  <h2>{heading}</h2>
  <p>{description}</p>
  <div class:list={["contact-groups", { "contact-groups-pair": kind === "both" }]}>
    {intents.map((intent) => {
      const action = actions[intent];
      const href = `mailto:${email}?subject=${encodeURIComponent(action.subject)}&body=${encodeURIComponent(`${action.body}\n\nFound you here: ${source}`)}`;
      const channels = intent === "role" ? [linkedin] : [linkedin, twitter];
      return <div class="contact-group" role="group" aria-label={action.label}>
        {kind === "both" && <h3>{action.label}</h3>}
        <div class="contact-actions">
          {channels.map((channel) => <a href={channel.href} target="_blank" rel="noopener noreferrer" data-contact-intent={intent} aria-label={`${action.label} on ${channel.label}`}>{channel.label} <span aria-hidden="true">↗</span></a>)}
          <a href={href} data-contact-intent={intent} aria-label={`${action.label} by email`}>Email <span aria-hidden="true">↗</span></a>
        </div>
      </div>;
    })}
  </div>
</section>
<style>
  .contact-invitation { margin-top: 34px; padding-top: 22px; border-top: 1px solid var(--site-border); }
  h2 { font-size: 14px; margin-bottom: 5px; }
  p { color: var(--site-muted); font-size: 13px; line-height: 1.8; max-width: 490px; }
  .contact-groups { margin-top: 12px; }
  .contact-groups-pair { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; margin-top: 17px; }
  h3 { font-size: 12px; font-weight: 400; margin-bottom: 6px; color: var(--site-muted); }
  .contact-actions { display: flex; flex-wrap: wrap; gap: 8px 18px; font-size: 13px; }
  a { text-decoration-color: var(--site-muted); }
  a:hover { text-decoration-color: currentColor; }
  a span { color: var(--site-muted); font-size: 11px; }
  @media (max-width: 380px) { .contact-groups-pair { grid-template-columns: minmax(0, 1fr); gap: 15px; } }
</style>
