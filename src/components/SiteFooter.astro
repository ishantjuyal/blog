---
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <nav aria-label="Elsewhere">
    <a href="mailto:ishantnit@gmail.com">Email</a>
    <a href="https://www.linkedin.com/in/ishantjuyal/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
    <a href="https://github.com/ishantjuyal/" target="_blank" rel="noopener noreferrer">GitHub</a>
    <a href="https://x.com/juyal_ishant" target="_blank" rel="noopener noreferrer">X</a>
    <a href="https://substack.com/@ishant" target="_blank" rel="noopener noreferrer">Substack</a>
  </nav>
  <span>© {year}</span>
</footer>
<style>
  .site-footer { display: flex; justify-content: space-between; align-items: baseline; gap: 20px; border-top: 1px solid var(--site-border); margin-top: 60px; padding: 22px 0 35px; color: var(--site-muted); font-size: 11px; }
  nav { display: flex; flex-wrap: wrap; gap: 18px; }
  a { text-decoration: none; }
  a:hover { color: var(--site-foreground); text-decoration: underline; }
  .site-footer > span { white-space: nowrap; font-family: var(--site-mono); font-size: 10px; }
  @media (max-width: 450px) { nav { gap: 13px; } .site-footer { margin-top: 44px; font-size: 10px; } }
</style>
