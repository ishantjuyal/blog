---
import AnalyticsTracker from "../components/AnalyticsTracker.astro";
import SiteFooter from "../components/SiteFooter.astro";
import "../styles/global.css";

export interface Props {
  title: string;
  description: string;
  canonicalURL?: string;
  articleDate?: Date;
  noindex?: boolean;
}
const { title, description, articleDate, noindex = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const canonicalURL = Astro.props.canonicalURL || new URL(path, Astro.site).toString();
const origin = Astro.site!.origin;
const imageURL = `${origin}/images/social-card.png`;
const preventIndexing = noindex || import.meta.env.DEV || process.env.VERCEL_ENV === "preview";
const person = {
  "@type": "Person", "@id": `${origin}/#person`, name: "Ishant Juyal", url: `${origin}/`,
  jobTitle: "Product Manager",
  sameAs: ["https://www.linkedin.com/in/ishantjuyal/", "https://github.com/ishantjuyal/", "https://x.com/juyal_ishant", "https://substack.com/@ishant"],
};
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    person,
    { "@type": "WebSite", "@id": `${origin}/#website`, name: "Ishant Juyal", url: `${origin}/`, publisher: { "@id": person["@id"] } },
    {
      "@type": articleDate ? "BlogPosting" : path === "/" ? "ProfilePage" : path === "/life" ? "AboutPage" : "WebPage",
      "@id": `${canonicalURL}#webpage`, url: canonicalURL, name: title, description, inLanguage: "en",
      isPartOf: { "@id": `${origin}/#website` },
      ...(articleDate ? { headline: title.replace(/ — Ishant Juyal$/, ""), datePublished: articleDate.toISOString(), author: { "@id": person["@id"] }, image: imageURL, mainEntityOfPage: canonicalURL } : path === "/" || path === "/life" ? { mainEntity: { "@id": person["@id"] } } : { author: { "@id": person["@id"] } }),
    },
  ],
};
const navItems = [
  { label: "Projects", href: "/projects" },
  { label: "Notes", href: "/notes" },
  { label: "Work", href: "/work" },
  { label: "Life", href: "/life" },
];
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Ishant Juyal" />
    {preventIndexing && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={articleDate ? "article" : "website"} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Ishant Juyal" />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Ishant Juyal — product manager, builder, and occasional writer." />
    {articleDate && <meta property="article:published_time" content={articleDate.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={imageURL} />
    <meta name="twitter:creator" content="@juyal_ishant" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, "\\u003c")} />
    <AnalyticsTracker />
  </head>
  <body>
    <a class="skip-link" href="#main" data-analytics-ignore="true">Skip to content</a>
    <div class="site-shell">
      <header class="site-header">
        <a class="site-mark" href="/" aria-label="Ishant Juyal — home">ij<span aria-hidden="true">.</span></a>
        <nav class="site-nav" aria-label="Primary navigation">
          {navItems.map((item) => (
            <a href={item.href} aria-current={path === item.href || path.startsWith(`${item.href}/`) ? "page" : undefined}>{item.label}</a>
          ))}
        </nav>
        {path === "/" && <button id="mode-toggle" class="mode-toggle" type="button" aria-pressed="false" aria-controls="home-content fun-world" hidden><span class="mode-symbol" aria-hidden="true">✳</span><span data-mode-label>Fun mode</span></button>}
      </header>
      <slot />
      <SiteFooter />
    </div>
  </body>
</html>
