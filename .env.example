# Mixpanel requires a token. Keep this blank locally; configure in Vercel production.
PUBLIC_MIXPANEL_TOKEN=

# Legacy host setting, used when PUBLIC_ANALYTICS_ALLOWED_HOSTS is absent.
PUBLIC_MIXPANEL_ALLOWED_HOSTS=ishantjuyal.com,www.ishantjuyal.com

# EU Mixpanel projects must send events to the EU ingestion endpoint.
PUBLIC_MIXPANEL_API_HOST=https://api-eu.mixpanel.com

# The existing GA4 web stream. Both providers stay silent off production hosts.
PUBLIC_GA_MEASUREMENT_ID=G-GPHNTYTXYB
PUBLIC_ANALYTICS_ALLOWED_HOSTS=ishantjuyal.com,www.ishantjuyal.com
