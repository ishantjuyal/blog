# Mixpanel only initializes when this token is set and the browser hostname
# matches PUBLIC_MIXPANEL_ALLOWED_HOSTS. Leave this blank locally.
PUBLIC_MIXPANEL_TOKEN=

# Comma-separated production hosts where Mixpanel is allowed to send events.
PUBLIC_MIXPANEL_ALLOWED_HOSTS=ishantjuyal.com,www.ishantjuyal.com
